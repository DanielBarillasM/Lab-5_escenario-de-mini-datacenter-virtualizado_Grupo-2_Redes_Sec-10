# Plantilla para lab5-db. No incluye wpadmin porque SFTP solo existe en la VM web.
# Copiar a /etc/ssh/sshd_config.d/99-lab5.conf después de sustituir marcadores.
# Validar con: sudo sshd -t

Port 22222
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
X11Forwarding no
AllowUsers __ADMIN_USER__
