# Copiar a /etc/ssh/sshd_config.d/99-lab5.conf después de sustituir marcadores.
# Validar con: sudo sshd -t

Port 22222
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
X11Forwarding no
AllowUsers __ADMIN_USER__ wpadmin

# OpenSSH mantiene el subsistema SFTP configurado por el paquete de Ubuntu.
# FileZilla debe usar una llave SSH para wpadmin.
